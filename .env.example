# AI Home Lab — single env file for the whole stack (MCP + Odysseus).
# Copy to .env at the repo root. Do not create services/odysseus/.env.

# Garmin MCP (internal Docker network)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_MCP_URL=http://garmin-mcp:8000/sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Odysseus (full reference: services/odysseus/.env.example after cloning)
# Pin ODYSSEUS_REF to a commit SHA for reproducible deploys (default: main).
ODYSSEUS_REPO=https://github.com/pewdiepie-archdaemon/odysseus.git
ODYSSEUS_REF=main
# Set ODYSSEUS_UPDATE=1 before deploy to pull a new ODYSSEUS_REF into an existing clone.
ODYSSEUS_UPDATE=0
APP_BIND=127.0.0.1
APP_PORT=7000
# Resolved relative to services/odysseus/docker-compose.yml → services/odysseus/data
APP_DATA_DIR=./data
APP_LOGS_DIR=./logs
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DOCKER_GID=963
PUID=1000
PGID=1000

# ntfy
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://localhost:8091
# Optional: set a topic name to receive deploy notifications (Track D).
NTFY_DEPLOY_TOPIC=

# Tailscale / remote access
# Bind Odysseus and ntfy to your Tailscale IP instead of 127.0.0.1, e.g.:
# APP_BIND=100.x.x.x
# NTFY_BIND=100.x.x.x
# ALLOWED_ORIGINS=http://100.x.x.x:7000

# Optional LLM providers for Odysseus
#
# The LLM base URL is configured in Odysseus (Admin → Model Endpoints), not here.
# After first login: Admin → Model Endpoints → pick OpenAI-compatible (or Custom)
#   Base URL: http://192.168.0.110:4000/v1   (LiteLLM on your LAN)
#   API key:  your LiteLLM key
# From inside Docker on the same host as LiteLLM, use host.docker.internal instead:
#   http://host.docker.internal:4000/v1
#
# Env vars below only help auto-discovery at startup; endpoints still live in Odysseus.
OPENAI_API_KEY=
# LLM_HOSTS=192.168.0.110
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # real Ollama only, not LiteLLM
# SEARXNG_SECRET=   # optional; auto-generated on first boot if unset

# Deploy health wait (seconds)
DEPLOY_WAIT_TIMEOUT=300
