# Garmin MCP (internal Docker network)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_MCP_URL=http://garmin-mcp:8000/sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Legacy agent SQLite (until custom agents are removed)
MASTER_KEY=REPLACE_WITH_FERNET_KEY
DB_PATH=/data/ai_home_lab.db

# Optional LiteLLM proxy (also configurable in Odysseus UI)
LITELLM_API_BASE=
LITELLM_API_KEY=
LITELLM_MODEL=

# Odysseus (see vendor/odysseus/.env.example for full list)
APP_BIND=127.0.0.1
APP_PORT=7000
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
ODYSSEUS_ADMIN_USER=admin
# ODYSSEUS_ADMIN_PASSWORD=  # auto-generated on first boot if unset
