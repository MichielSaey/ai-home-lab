# AI Home Lab — single env file for the whole stack (MCP + Odysseus).
# Copy to .env at the repo root. Do not create services/odysseus/.env.

# Garmin MCP (internal Docker network)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_MCP_URL=http://garmin-mcp:8000/mcp
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Optional home location for weather in the training plan (Open-Meteo, no API key).
# Leave blank to disable weather (avg temp per past week, per-day blocks for the
# current/upcoming week). Decimal degrees, e.g. Antwerp: 51.22 / 4.40.
GARMIN_HOME_LAT=
GARMIN_HOME_LON=

# Actual Budget MCP (internal Docker network; SSE transport)
# ACTUAL_SERVER_URL must reach your homelab Actual server (e.g. via Tailscale).
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
# Optional: default budget sync ID if you have multiple budgets
ACTUAL_BUDGET_SYNC_ID=
# Optional: separate unlock password if different from ACTUAL_PASSWORD
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
# Required with --enable-bearer; use the same token in Odysseus MCP admin (Track G.4)
ACTUAL_BEARER_TOKEN=
ACTUAL_MCP_URL=http://actual-mcp:3000

# Todoist MCP (internal Docker network; Streamable HTTP)
# API token: Todoist → Settings → Integrations → Developer
TODOIST_API_KEY=
TODOIST_MCP_URL=http://todoist-mcp:3001/mcp

# Odysseus (full reference: services/odysseus/.env.example after cloning)
# Pin ODYSSEUS_REF to a commit SHA for reproducible deploys (default: main).
ODYSSEUS_REPO=https://github.com/pewdiepie-archdaemon/odysseus.git
ODYSSEUS_REF=main
# Set ODYSSEUS_UPDATE=1 before deploy to pull a new ODYSSEUS_REF into an existing clone.
ODYSSEUS_UPDATE=0
# Host bind for Odysseus (docker publish). Default 127.0.0.1 = localhost on the server only.
# For LAN access from other machines, use 0.0.0.0 or the server's LAN IP (e.g. 192.168.0.110).
APP_BIND=127.0.0.1
APP_PORT=7000
# Resolved relative to services/odysseus/docker-compose.yml → services/odysseus/data
APP_DATA_DIR=./data
APP_LOGS_DIR=./logs
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Comma-separated browser origins Odysseus accepts. Required when browsing by IP/hostname
# instead of localhost, e.g. ALLOWED_ORIGINS=http://192.168.0.110:7000
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
DOCKER_GID=963
PUID=1000
PGID=1000

# ntfy
# Match APP_BIND when exposing ntfy to the LAN (NTFY_BASE_URL should use the same host).
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://localhost:8091
# Optional: set a topic name to receive deploy notifications (Track D).
NTFY_DEPLOY_TOPIC=

# Tailscale / remote access
# Bind Odysseus and ntfy to your Tailscale IP instead of 127.0.0.1, e.g.:
# APP_BIND=100.x.x.x
# NTFY_BIND=100.x.x.x
# ALLOWED_ORIGINS=http://100.x.x.x:7000

# LAN access (same network as the CasaOS/server host)
# APP_BIND=0.0.0.0
# NTFY_BIND=0.0.0.0
# NTFY_BASE_URL=http://192.168.0.110:8091
# ALLOWED_ORIGINS=http://192.168.0.110:7000
# Then open http://192.168.0.110:7000 from another machine on the LAN.
# After changing APP_BIND, restart: docker compose up -d odysseus

# Optional LLM providers for Odysseus
#
# The LLM base URL is configured in Odysseus (Admin → Model Endpoints), not here.
# After first login: Admin → Model Endpoints → pick OpenAI-compatible (or Custom)
#   Base URL: http://192.168.0.110:4000/v1   (LiteLLM on your LAN)
#   API key:  your LiteLLM key
# From inside Docker on the same host as LiteLLM, use host.docker.internal instead:
#   http://host.docker.internal:4000/v1
#
# Env vars below only help auto-discovery at startup; endpoints still live in Odysseus.
OPENAI_API_KEY=
# LLM_HOSTS=192.168.0.110
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # real Ollama only, not LiteLLM
# SEARXNG_SECRET=   # optional; auto-generated on first boot if unset

# Deploy health wait (seconds)
DEPLOY_WAIT_TIMEOUT=300
