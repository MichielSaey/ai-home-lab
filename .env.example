# Garmin MCP
MASTER_KEY=REPLACE_WITH_FERNET_KEY
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_MCP_URL=http://garmin-mcp:8000/sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Odysseus (see services/odysseus/.env.example for full list)
# Pin ODYSSEUS_REF to a commit SHA for reproducible deploys (default: main).
ODYSSEUS_REPO=https://github.com/pewdiepie-archdaemon/odysseus.git
ODYSSEUS_REF=main
# Set ODYSSEUS_UPDATE=1 before deploy to pull a new ODYSSEUS_REF into an existing clone.
ODYSSEUS_UPDATE=0
APP_BIND=127.0.0.1
APP_PORT=7000
APP_DATA_DIR=./services/odysseus/data
APP_LOGS_DIR=./services/odysseus/logs
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DOCKER_GID=963
PUID=1000
PGID=1000

# ntfy
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://localhost:8091
# Optional: set a topic name to receive deploy notifications (Track D).
NTFY_DEPLOY_TOPIC=

# Tailscale / remote access
# Bind Odysseus and ntfy to your Tailscale IP instead of 127.0.0.1, e.g.:
# APP_BIND=100.x.x.x
# NTFY_BIND=100.x.x.x
# ALLOWED_ORIGINS=http://100.x.x.x:7000

# Optional LLM providers for Odysseus
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Deploy health wait (seconds)
DEPLOY_WAIT_TIMEOUT=300
